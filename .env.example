# MongoDB connection (server-only)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.example.mongodb.net
MONGODB_DB=messmass

# SSO service base URL (server-only; base URL only, no tokens)
SSO_BASE_URL=https://sso.example.com

# --- Real OAuth2/OIDC client (replaces the old token-validate-only SSO shortcut) ---
# Register messmass as an OAuth client on the SSO server first (see
# SSO_EMAIL_UNIFICATION_PLAN.md / scripts/register-messmass-client.mjs in the sso repo).
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# messmass is registered as a confidential client by default (server-side token
# exchange only, no PKCE required). Set to 0/false only if re-registered as public.
SSO_CONFIDENTIAL_OAUTH=1

# Application URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Client-exposed URLs (only NEXT_PUBLIC_* keys are available in the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ImgBB API key, client-exposed. ImgBB is now a best-effort mirror only (Vercel
# Blob is the required primary, see BLOB_READ_WRITE_TOKEN below) -- leaving this
# unset just disables the mirror, uploads still work. Browser uploads to imgbb go
# straight from the browser to avoid Vercel's 4.5MB serverless request body cap.
# Get your key from: https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_API_KEY=

# Bitly API integration (server-only)
# Get your access token from: https://bitly.com/a/settings/api
BITLY_ACCESS_TOKEN=
# Optional: Organization/Group GUID to restrict API calls to specific workspace
BITLY_ORGANIZATION_GUID=

# Football-Data.org API integration (server-only)
# WHAT: Required for fixture scheduling and team enrichment
# WHY: Enables automatic event creation from scheduled matches and enhanced partner KYC
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_SYNC_INTERVAL_HOURS=6
FOOTBALL_DATA_AUTO_CREATE_PROJECTS=true
FOOTBALL_DATA_AUTO_CREATE_PARTNERS=true

# Email (transactional — admin password regeneration, config self-test)
# WHAT: lib/emailNotifications.ts sends via camera's shared internal email
#       service (POST /api/internal/email/send), not a direct Resend
#       integration — messmass has no Resend account/key of its own.
# WHY: Camera is the one app in the stack with a verified Resend sending
#      domain; this avoids every app duplicating that integration.
# No new vars needed here — reuses CAMERA_BASE_URL and
# CAMERA_MESSMASS_INTERNAL_SECRET below (the same credentials already used
# for messmass -> camera provisioning).

# Cron authorization (server-only)
# WHAT: Shared secret required by scheduled endpoints (/api/bitly/sync,
#       /api/cron/*). Vercel sends it as `Authorization: Bearer <value>`.
# WHY: REQUIRED in production — cron routes fail closed when it is unset
#      (messmass#348), so scheduled jobs 401 until it is configured.
CRON_SECRET=

# Security hardening flags (server-only)
# WHAT: Mandatory for production readiness (OPS-SEC-01)
# WHY: Protect user data, sessions, and prevent code injection
ENABLE_BCRYPT_AUTH=false
ENABLE_JWT_SESSIONS=false
ENABLE_HTML_SANITIZATION=false
ENABLE_SAFE_FORMULA_PARSER=false

# JWT Secret (server-only)
# WHAT: Cryptographic secret for signing session tokens
# WHY: Prevents token tampering when ENABLE_JWT_SESSIONS=true
# REQUIREMENT: Minimum 32 characters in production
JWT_SECRET=

# Security guidance:
# - Do NOT commit real secrets.
# - Keep secrets in environment providers; never in DB unless an approved encryption scheme exists.
# - Client-visible values MUST use NEXT_PUBLIC_*.
# - In production, all ENABLE_*_SECURITY flags MUST be set to true.

# --- messmass -> camera provisioning (messmass is master for orgs/partners/events) ---
# When set, creating an event auto-provisions the mirror event in camera.
# Also doubles as the auth for camera's shared email service (lib/emailNotifications.ts)
# AND for validating inbound camera -> messmass partner-sync requests
# (app/api/integrations/camera/partners/route.ts, lib/cameraPartnerSync.ts) —
# same secret, same trust boundary, both directions, not a second credential to manage.
CAMERA_BASE_URL=http://localhost:3000
CAMERA_MESSMASS_INTERNAL_SECRET=

# --- fanmass integration (image analytics) ---
# FANMASS_BASE_URL + FANMASS_API_KEY: messmass -> fanmass pulls (analytics
# summaries via GET {FANMASS_BASE_URL}/api/integrations/messmass/...; the key is
# sent as x-api-key and must match fanmass's FANMASS_API_KEY / settings apiKey).
# Local fanmass runs on http://localhost:8787.
FANMASS_BASE_URL=
FANMASS_API_KEY=
# Token fanmass presents when calling /api/integrations/fanmass/* here (Bearer or
# x-api-key; must match fanmass's MESSMASS_API_KEY / settings messmassApiKey).
# Also protects the camera ops endpoints /api/integrations/camera/*.
# Fallback env name: MESSMASS_FANMASS_TOKEN.
FANMASS_INTEGRATION_TOKEN=
# fanmass's own web UI origin (its React SPA). Not currently read by any
# messmass route — the "Fanmass" admin nav item now hosts fanmass's
# dashboards natively (fed by the fanmass_dashboard_snapshot push channel,
# see docs/messmass-integration-delivery-plan-2026-06-25.md), not via an
# outbound link. Kept for a possible future "open in fanmass directly"
# escape hatch.
FANMASS_APP_URL=http://localhost:8787

# --- Admin session (server-only) ---
# WHAT: signing secret and idle timeout for the admin-session cookie.
# WHY: set in production but previously absent here, so a deployment configured
# only from this file booted without them.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TIMEOUT=

# --- Superadmin bootstrap ---
# Email of the account scripts/ensureSuperadmin.ts promotes. Pairs with
# SUPERADMIN_PASSWORD, which that script reads directly and which is
# deliberately not listed here.
SUPERADMIN_EMAIL=

# --- Image hosting (primary: Vercel Blob) ---
# Required. Create the store in the Vercel dashboard (Storage tab) as Public
# access -- fixed permanently at creation. Also used by app/api/blob-upload-token
# (mints short-lived client-upload tokens for direct browser uploads, same
# 4.5MB-cap workaround as the imgbb client path below).
BLOB_READ_WRITE_TOKEN=

# --- Image hosting (server-side uploads, best-effort mirror) ---
# Server-side counterpart to NEXT_PUBLIC_IMGBB_API_KEY.
IMGBB_API_KEY=

# --- Bitly ---
# Group GUID the Bitly sync writes into. Pairs with BITLY_ACCESS_TOKEN and
# BITLY_ORGANIZATION_GUID above.
BITLY_GROUP_GUID=

# --- API-Football ---
# Key for the api-football.com enrichment scripts (api-football:* npm scripts).
# Distinct from FOOTBALL_DATA_API_TOKEN, which is football-data.org.
API_FOOTBALL_KEY=

# --- Google Sheets service account ---
# WHAT: service-account credentials for the Google Sheets sync.
# WHY: GOOGLE_SHEETS_PRIVATE_KEY is a PEM block — keep the literal \n escapes
# when setting it in a provider UI.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# --- GitHub App (roadmap/board sync) ---
# App id, installation id, and PEM private key for the GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_INSTALL_ID=
GITHUB_APP_PRIVATE_KEY=
